{
  "description": "Andes: desktop notification when Claude needs you (a permission prompt or a question).",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/notify.mjs", "--harness=claude"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
