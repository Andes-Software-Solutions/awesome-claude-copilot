{
  "version": 1,
  "hooks": {
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt|elicitation_dialog",
        "bash": "command -v node >/dev/null 2>&1 || exit 0; node \"$PLUGIN_ROOT/scripts/notify.mjs\" --harness=copilot",
        "powershell": "$OutputEncoding = [Text.UTF8Encoding]::new($false); if (Get-Command node -ErrorAction SilentlyContinue) { $input | node \"$env:PLUGIN_ROOT/scripts/notify.mjs\" --harness=copilot }",
        "timeoutSec": 10
      }
    ]
  }
}
