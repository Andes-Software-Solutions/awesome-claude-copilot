{
  "version": 1,
  "hooks": {
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt|elicitation_dialog",
        "bash": "command -v node >/dev/null 2>&1 || exit 0; node \"$PLUGIN_ROOT/scripts/notify.mjs\" --harness=copilot --event=notification",
        "powershell": "$OutputEncoding = [Text.UTF8Encoding]::new($false); if (Get-Command node -ErrorAction SilentlyContinue) { $input | node \"$env:PLUGIN_ROOT/scripts/notify.mjs\" --harness=copilot --event=notification }",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "command -v node >/dev/null 2>&1 || exit 0; node \"$PLUGIN_ROOT/scripts/notify.mjs\" --harness=copilot --event=stop",
        "powershell": "$OutputEncoding = [Text.UTF8Encoding]::new($false); if (Get-Command node -ErrorAction SilentlyContinue) { $input | node \"$env:PLUGIN_ROOT/scripts/notify.mjs\" --harness=copilot --event=stop }",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit|create",
        "bash": "command -v node >/dev/null 2>&1 || exit 0; node \"$PLUGIN_ROOT/scripts/check-links.mjs\" --harness=copilot --defer-to-repo-hook",
        "powershell": "$OutputEncoding = [Text.UTF8Encoding]::new($false); if (Get-Command node -ErrorAction SilentlyContinue) { $input | node \"$env:PLUGIN_ROOT/scripts/check-links.mjs\" --harness=copilot --defer-to-repo-hook }",
        "timeoutSec": 30
      }
    ]
  }
}
